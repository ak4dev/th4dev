{
  "name": "th4dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "dev:https": "TH4_HTTPS=1 vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync": "aws s3 sync ./dist/assets/ s3://$BUCKET/assets/ --cache-control 'public, max-age=31536000, immutable' && aws s3 sync ./dist/ s3://$BUCKET --exclude 'assets/*' --cache-control 'no-cache, must-revalidate' && aws cloudfront create-invalidation --distribution-id $DIST_ID --paths '/*'",
    "deploy": "npm run build && BUCKET=$TH4_BUCKET DIST_ID=$TH4_DIST_ID npm run sync",
    "deploy:cdk": "npm run build && npm --prefix infra run deploy:all",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@stitches/react": "^1.2.8",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.2",
    "vite-plugin-mkcert": "^1.17.10",
    "vitest": "^4.1.0"
  }
}
