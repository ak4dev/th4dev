{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    /*
     * `noUncheckedIndexedAccess` and `exactOptionalPropertyTypes` are
     * deliberately off. The slider and input maps are keyed by the SliderKey
     * and InputKey unions in app-constants.ts, so indexing them is already
     * total and the unchecked-access sites the audit counted are gone at the
     * source. Turning the flags on would add churn across UI files that carry
     * far less test coverage than the helpers, for no correctness gain here.
     * Recorded as a decision, not an oversight.
     */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
